<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/notepad_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FF3A3000" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/n_add" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="+" android:textSize="24sp" android:textColor="#FF8A6D00" />
    </LinearLayout>
    <TextView android:id="@+id/n_body" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="6dp" android:textColor="#FF3A3000" android:textSize="14sp" android:lineSpacingExtra="4dp" />
</LinearLayout>
